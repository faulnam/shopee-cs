{
  "manifest_version": 3,
  "name": "Shopee CS Auto-Reply Bot (Local)",
  "version": "1.0.0",
  "description": "Auto-reply customer chat Shopee Seller Center pakai AI (Laravel + OpenRouter/DeepSeek)",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://seller.shopee.co.id/*",
    "https://shopee.cs.norapade.my.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.shopee.co.id/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
